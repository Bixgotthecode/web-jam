<!DOCTYPE html>
<html lang="en">
  <head>

    <!--
      This is the main Handlebars template for the site
      - When the user visits the homepage or submits a color the app calls the endpoints in server.js
      - The server script passes data in here and the Handlebars code builds it into the HTML page
    -->

    <meta charset="utf-8" />
    <link rel="icon" href="https://tomcollinsresearch.net/cma4w/assets/logos/cma4w_logo.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{seo.title}}</title>

    <!-- Meta tags for SEO and social sharing -->
    <link rel="canonical" href="{{seo.url}}">
    <meta name="description" content="{{seo.description}}">
    <meta property="og:title" content="{{seo.title}}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{seo.url}}">
    <meta property="og:description" content="{{seo.description}}">
    <meta property="og:image" content="{{seo.image}}">
    <meta name="twitter:card" content="summary">

    <!-- Import the webpage's stylesheet -->
    <link rel="stylesheet" href="./style.css" />
    <script src="./client.js" defer></script>

  </head>
  <body>
    <div class="wrapper">
      <div class="content" role="main">

        <!-- This is the start of content for our page -->
        <h1 class="title">save-bgcol</h1>

        <p>
          Welcome to a minimal example of a progressive web app (PWA) that supports sign in via magic links, and choosing and saving your preferred background colour for the page. That's it!
        </p>

        <div class="email-colour-fun">
          <form id="emailColourForm" class="email-colour-form" method="post">
          <!-- <form id="emailColourForm" class="email-colour-form" method="post" onsubmit="return myClient.check_email()"> -->
          <!-- <form id="emailColourForm" class="email-colour-form" method="post" onsubmit="return check_email()"> -->
            <div id="magicLinkArea">
              <label for="emailAddr">
                Get a magic link sent to your email address:
              </label>
              <br>
              <input id="emailAddr" name="emailAddr" required="required" type="text">
              <button type="submit">Submit</button>
              <br><br>
            </div>

            <label id="bgcolSelLabel" for="bgcolSel">
              Choose your background colour (after signing in):
            </label>
            <br>
            <select id="bgcolSel" name="bgcolSel" disabled>
              <option value="MistyRose">Misty rose</option>
              <option value="PapayaWhip">Papaya whip</option>
              <option value="PeachPuff">Peach puff</option>
            </select>

            <!-- <br><br>
            <br><br>
            <input id="testRemove" type="button" value="(test)"> -->
            <br><br>
          </form>

        <div class="illo-container">
          <img id="logoImg" src="https://tomcollinsresearch.net/cma4w/assets/logos/cma4w_logo.png" class="illustration" alt="CMA4W logo" />
        </div>

        <!-- Instructions on using this project -->
        <div class="instructions">
          <h2>
            Using this project
          </h2>
          <p>
            This is a remix of the Glitch <strong>Hello Node</strong> project. You can
            use it to build your own app. Check out README.md in the editor for
            more info and next steps you can take!
          </p>
        </div>

      </div>
    </div>
    <!-- The footer holds our remix button — you can use it for structure or cut it out ✂ -->
    <footer class="footer">
      <div class="links"></div>
      <a
        class="btn--remix"
        target="_top"
        href="https://github.com/tomthecollins/save-bgcol"
      >
        <img
          src="https://tomcollinsresearch.net/cma4w/assets/logos/cma4w_logo.ico"
          alt="CMA4W icon"
        />
        Source code
      </a>
    </footer>
  </body>
</html>
